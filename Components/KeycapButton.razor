<button type="@Type"
        class="keycap @(Size == "sm" ? "keycap-sm" : "") @Class @(Disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : "")"
        @onclick="HandleClick"
        disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span>@Icon</span>
    }
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(Text))
    {
        <span>@Text</span>
    }
    @if (!string.IsNullOrEmpty(Shortcut))
    {
        <span class="kbd-chip ml-1.5 text-[10px] bg-black/10 border-black/20 text-keyInk/70">@Shortcut</span>
    }
</button>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Shortcut { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!Disabled && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }
}
