<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>

    <!-- Enable IL Trimming for framework BCL -->
    <PublishTrimmed>true</PublishTrimmed>

    <!-- Strip heavy ICU globalization data -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Force pre-compressed .br and .gz generation -->
    <BlazorEnableCompression>true</BlazorEnableCompression>

    <!-- AOT Compilation: bundles 40 framework assemblies into ~5-10 files -->
    <RunAOTCompilation>true</RunAOTCompilation>

    <!-- Strip IL after AOT to reduce bundle size by ~15-20% -->
    <WasmStripIL>true</WasmStripIL>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.13" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="0.40.0" />
  </ItemGroup>

  <!-- Correct ItemGroup element placement to prevent stripping DevDen pages/routes -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DevDen" />
    <TrimmerRootAssembly Include="Markdig" />
  </ItemGroup>

  <!-- Enforce Tailwind v3 execution during Release build -->
  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npx tailwindcss@3 -i ./wwwroot/css/tailwind.input.css -o ./wwwroot/css/app.css --minify" ContinueOnError="true" />
  </Target>

</Project>