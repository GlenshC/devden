@inject NavigationManager Nav
@inject AppState AppState
@implements IDisposable

<div class="aurora-container transition-opacity duration-700 @(IsHomeRoute ? "opacity-100" : "opacity-25")">
    <!-- Blade 1: Crimson Core -->
    <div class="aurora-blade animate-blade-1 w-[600px] h-[600px] -top-[200px] -left-[150px] opacity-70"
         style="background: radial-gradient(circle, #ff2f3a 0%, #ff6b4a 45%, rgba(255, 47, 58, 0) 70%);">
    </div>

    <!-- Blade 2: Coral Swirl -->
    <div class="aurora-blade animate-blade-2 w-[700px] h-[550px] top-[10%] right-[-100px] opacity-60"
         style="background: radial-gradient(circle, #ff6b4a 0%, #ffb347 50%, rgba(255, 107, 74, 0) 75%);">
    </div>

    <!-- Blade 3: Amber Flare -->
    <div class="aurora-blade animate-blade-3 w-[500px] h-[500px] bottom-[15%] left-[20%] opacity-65"
         style="background: radial-gradient(circle, #ffb347 0%, #ff6b4a 40%, rgba(255, 179, 71, 0) 70%);">
    </div>

    <!-- Blade 4: Deep Crimson Ambient Ground -->
    <div class="aurora-blade animate-blade-4 w-[650px] h-[650px] -bottom-[200px] -right-[150px] opacity-50"
         style="background: radial-gradient(circle, #ff2f3a 0%, #07080a 60%, rgba(7, 8, 10, 0) 80%);">
    </div>

    <!-- Radial Vignette on top -->
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(circle at 50% 50%, transparent 40%, rgba(7, 8, 10, 0.7) 100%);">
    </div>

    <!-- Film Grain Overlay using SVG Turbulence -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.14] mix-blend-overlay"
         style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;);">
    </div>
</div>

@code {
    private bool IsHomeRoute => AppState.CurrentRoute == "/" || AppState.CurrentRoute == "";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        AppState.OnChange += HandleStateChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var relative = Nav.ToBaseRelativePath(e.Location);
        AppState.CurrentRoute = "/" + relative;
        StateHasChanged();
    }

    private void HandleStateChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        AppState.OnChange -= HandleStateChanged;
    }
}
