@page "/p/{ProjectKey}/board"
@inject AppState AppState
@inject ItemService ItemService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Board — @(AppState.ActiveProject?.Name ?? "DevDen")</PageTitle>

@if (AppState.ActiveProject == null)
{
    <div class="py-12 text-center text-muted">
        Loading project board...
    </div>
}
else
{
    <!-- Board Header -->
    <div class="flex items-center justify-between mb-4">
        <div>
            <h1 class="text-xl font-bold text-fg flex items-center gap-2">
                <span>@AppState.ActiveProject.Name</span>
                <span class="text-xs font-mono text-muted bg-white/5 px-2 py-0.5 rounded border border-white/5">
                    Board
                </span>
            </h1>
            <p class="text-xs text-muted">
                @AppState.ActiveItems.Count total items · @(AppState.ActiveItems.Count(i => AppState.ActiveStatuses.FirstOrDefault(s => s.Id == i.StatusId)?.Category == StatusCategory.Done)) done
            </p>
        </div>

        <div class="flex items-center gap-2">
            <span class="hidden sm:inline text-xs text-muted/60 font-mono">
                Drag cards to reorder or change status
            </span>
        </div>
    </div>

    <!-- Kanban Columns Scroll Container -->
    <div class="flex items-start gap-4 overflow-x-auto pb-6 pt-1">
        @foreach (var status in AppState.ActiveStatuses.OrderBy(s => s.Order))
        {
            var columnItems = AppState.ActiveItems.Where(i => i.StatusId == status.Id).OrderBy(i => i.Order).ToList();

            <StatusColumn Status="@status"
                          Items="@columnItems"
                          OnDraggingStarted="HandleDraggingStarted"
                          OnItemDropped="HandleItemDropped" />
        }
    </div>
}

@code {
    [Parameter] public string ProjectKey { get; set; } = "";

    private Item? _draggingItem;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        SyncProject();
    }

    protected override void OnParametersSet()
    {
        SyncProject();
    }

    private void SyncProject()
    {
        if (!string.IsNullOrEmpty(ProjectKey))
        {
            AppState.SetActiveProjectByKey(ProjectKey);
        }
    }

    private void HandleDraggingStarted(Item item)
    {
        _draggingItem = item;
    }

    private void HandleItemDropped((Guid ItemId, Guid TargetStatusId, Guid? BeforeItemId) dropData)
    {
        if (_draggingItem == null) return;

        // Perform move
        ItemService.MoveItem(_draggingItem.Id, dropData.TargetStatusId, dropData.BeforeItemId);
        _draggingItem = null;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
